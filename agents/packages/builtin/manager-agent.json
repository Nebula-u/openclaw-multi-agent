{
  "schema_version": 1,
  "kind": "openclaw-agent-package",
  "id": "manager-agent",
  "display_name": "Manager Agent",
  "description": "唯一用户入口与工作流总控。",
  "origin": "builtin",
  "protected": true,
  "deletable": false,
  "workspace_source_rel": "agents/manager-agent/workspace",
  "runtime_subdir": "agents/manager-agent",
  "role": "manager",
  "capabilities": ["workflow.orchestration", "agent.lifecycle", "skill.lifecycle"],
  "model": "",
  "delegation": { "callable_by_manager": false, "allow_agents": [], "require_agent_id": true, "delegation_mode": "off" },
  "sandbox_mode": "all",
  "sandbox_config": {
    "mode": "all",
    "backend": "docker",
    "scope": "session",
    "workspaceAccess": "rw",
    "docker": {
      "image": "openclaw-test-node:22-slim",
      "workdir": "/workspace",
      "network": "none",
      "readOnlyRoot": true,
      "capDrop": ["ALL"],
      "pidsLimit": 128,
      "memory": "512m",
      "cpus": 1,
      "dangerouslyAllowExternalBindSources": true,
      "dangerouslyAllowReservedContainerTargets": false
    }
  },
  "tools_config": {
    "profile": "minimal",
    "alsoAllow": ["read", "write", "edit"],
    "deny": ["exec", "apply_patch", "browser", "web_search", "web_fetch", "image_generate", "message"]
  },
  "assembly": { "include_common_rules": true, "include_templates": true },
  "skills": ["skill-creator", "agent-package-manager"],
  "lifecycle": { "register": true, "active": true }
}
