{
  "schema_version": 1,
  "kind": "openclaw-agent-package",
  "id": "test-agent",
  "display_name": "Test Agent",
  "description": "补充并真实执行测试，保留原始测试证据。",
  "origin": "builtin",
  "protected": true,
  "deletable": false,
  "workspace_source_rel": "agents/test-agent/workspace",
  "runtime_subdir": "agents/test-agent",
  "role": "worker",
  "capabilities": ["testing.plan", "testing.implementation", "testing.execution"],
  "model": "deepseek/deepseek-v4-flash",
  "delegation": { "callable_by_manager": true, "allow_agents": [] },
  "sandbox_mode": "all",
  "sandbox_config": {
    "mode": "all",
    "backend": "docker",
    "scope": "session",
    "workspaceAccess": "none",
    "docker": {
      "image": "openclaw-test-node:22-slim",
      "network": "none",
      "readOnlyRoot": true,
      "capDrop": ["ALL"],
      "pidsLimit": 256,
      "memory": "2g",
      "cpus": 2
    }
  },
  "tools_config": {
    "exec": { "host": "sandbox" },
    "elevated": { "enabled": false }
  },
  "assembly": { "include_common_rules": true, "include_templates": false },
  "skills": [],
  "lifecycle": { "register": true, "active": true }
}
