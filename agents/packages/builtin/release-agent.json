{
  "schema_version": 1,
  "kind": "openclaw-agent-package",
  "id": "release-agent",
  "display_name": "Release Agent",
  "description": "受控发布前检查、部署与上线验证。",
  "origin": "builtin",
  "protected": true,
  "deletable": false,
  "workspace_source_rel": "agents/release-agent/workspace",
  "runtime_subdir": "agents/release-agent",
  "role": "worker",
  "capabilities": ["release.readiness", "release.deployment", "release.online-verification", "operations.handoff"],
  "model": "",
  "delegation": { "callable_by_manager": false, "allow_agents": [] },
  "sandbox_mode": null,
  "tools_config": {
    "profile": "minimal",
    "alsoAllow": ["read", "write", "exec"],
    "deny": ["apply_patch", "browser", "web_search", "web_fetch", "image_generate", "message"],
    "exec": { "host": "gateway", "security": "allowlist", "ask": "off", "strictInlineEval": true, "timeoutSec": 300 }
  },
  "assembly": { "include_common_rules": true, "include_templates": false },
  "skills": [],
  "lifecycle": { "register": true, "active": true }
}
