{
  "schema_version": 1,
  "kind": "openclaw-agent-package",
  "id": "release-agent",
  "display_name": "Release Agent",
  "description": "运维交接前的发布候选校验。",
  "origin": "builtin",
  "protected": true,
  "deletable": false,
  "workspace_source_rel": "agents/release-agent/workspace",
  "runtime_subdir": "agents/release-agent",
  "role": "worker",
  "capabilities": ["release.readiness", "operations.handoff"],
  "model": "deepseek/deepseek-v4-flash",
  "delegation": { "callable_by_manager": true, "allow_agents": [] },
  "sandbox_mode": null,
  "assembly": { "include_common_rules": true, "include_templates": false },
  "skills": [],
  "lifecycle": { "register": true, "active": true }
}
