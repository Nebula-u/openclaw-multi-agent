{
  "name": "openclaw-multi-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:runtime-guard && npm run test:agent-json && npm run test:runtime-bundle && npm run test:control-kernel && npm run test:monitor && npm run test:legacy-migration && node --test tests/validate-install.test.mjs",
    "test:runtime-guard": "node --test tests/runtime-guard.test.mjs",
    "test:agent-json:offline": "node --test tests/agent-llm-json-harness.test.mjs",
    "test:agent-json": "npm run test:agent-json:offline",
    "agent-json:real": "node scripts/agent-json-harness/collect-llm-failures.mjs",
    "agent-json:collect": "npm run agent-json:real",
    "agent-contract:test": "node scripts/agent-llm-contract-tests/run-contract.mjs",
    "test:runtime-bundle": "node --test tests/runtime-bundle.test.mjs",
    "test:control-kernel": "node --test tests/control-kernel.test.mjs tests/task-repository.test.mjs tests/control-kernel-resilience.test.mjs",
    "test:monitor": "node --test tests/monitor-*.test.mjs tests/manager-wake-outbox.test.mjs",
    "test:legacy-migration": "node --test tests/legacy-migration.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
