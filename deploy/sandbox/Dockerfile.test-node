FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i 's|deb.debian.org|mirrors.cloud.tencent.com|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install --yes --no-install-recommends bash ca-certificates git python3 ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 sandbox \
  && useradd --create-home --uid 10001 --gid 10001 --shell /bin/bash sandbox \
  && mkdir -p /worktree /input /agent-raw /raw-logs \
  && chown -R sandbox:sandbox /worktree /input /agent-raw /raw-logs

USER sandbox
WORKDIR /worktree
ENV HOME=/home/sandbox
