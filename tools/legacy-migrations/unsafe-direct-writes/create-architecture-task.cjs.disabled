const fs=require('fs'),path=require('path'),crypto=require('crypto');const repo='D:/MicroConnect/project/openclaw-multi-agent',rt=repo+'/runtime',wf='WF-ef1c5f87-93c5-4ec7-a074-3dea54831ca1',oldTask='TASK-88df9a42-f643-4607-b296-5bae3337c8d8',oldRun='RUN-4a01107f-aa24-465e-aebe-0bc01b34181d',wd=`${rt}/control/workflows/${wf}`,now=new Date().toISOString(),uuid=()=>crypto.randomUUID();const task=`TASK-${uuid()}`,run=`RUN-${uuid()}`,art=`${rt}/artifacts/${wf}/${task}/${run}`,input=`${art}/input`,output=`${art}/output`,wt=`${rt}/worktrees/${wf}/${task}/${run}/repo`;fs.mkdirSync(input,{recursive:true});fs.mkdirSync(output,{recursive:true});const oldArt=`${rt}/artifacts/${wf}/${oldTask}/${oldRun}`;for(const f of ['context.md','rules.md','acceptance-criteria.json','approved-decisions.json'])fs.copyFileSync(`${oldArt}/input/${f}`,`${input}/${f}`);const taskObj={schema_version:1,workflow_id:wf,task_id:task,run_id:run,parent_task_id:oldTask,task_type:'ARCHITECTURE',assigned_agent:'architect-agent',title:'Design TaskFlow architecture',description:'基于已批准需求设计纯前端 TaskFlow 架构、组件映射、测试策略、数据模型与关键取舍，不修改目标代码。',status:'READY',dependencies:[oldTask],acceptance_criteria_ids:[],attempt:1,max_attempts:3,input_commit:'302f591c08147dbfa66bd0f72181031ebb03e1f3',expected_branch:null,worktree_path_abs:wt,artifact_root_abs:art,context_manifest_path_abs:`${input}/context-manifest.json`,allowed_write_paths_abs:[output],forbidden_paths_abs:[`${rt}/agents/manager-agent/workspace/.git`],required_outputs:[`${output}/result.json`,`${output}/architecture-report.md`,`${output}/test-strategy.md`,`${output}/user-summary.md`,`${output}/evidence.jsonl`,`${output}/command-records.jsonl`,`${output}/checksums.sha256`],approval_dependencies:[],created_at:now,updated_at:now};const tpath=`${wd}/tasks/${task}.json`;fs.writeFileSync(tpath,JSON.stringify(taskObj,null,2));const sha=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const names=['context.md','rules.md','acceptance-criteria.json','approved-decisions.json'];const manifest={schema_version:1,workflow_id:wf,task_id:task,run_id:run,assigned_agent:'architect-agent',created_at:now,manager_session_reference:'agent:manager-agent:main',target_project_root_abs:`${rt}/agents/manager-agent/workspace`,worktree_path_abs:wt,artifact_root_abs:art,input_files:names.map(n=>({path_abs:`${input}/${n}`,sha256:sha(`${input}/${n}`),role:n})),rule_version:'rules-v1+policy-default-v1',rule_hash:sha(`${input}/rules.md`),input_commit:'302f591c08147dbfa66bd0f72181031ebb03e1f3',expected_output_paths:taskObj.required_outputs};fs.writeFileSync(`${input}/context-manifest.json`,JSON.stringify(manifest,null,2));const c=`# Architecture Task Context\n\n已批准的 TaskFlow A 方案需求与验收标准位于同目录输入文件。请产出组件映射、数据模型、状态管理、UI 结构、测试策略、关键 ADR、兼容性评估。\n\n需求报告：${oldArt}/output/requirement-report.md\n`;fs.writeFileSync(`${input}/context.md`,c);manifest.input_files=names.map(n=>({path_abs:`${input}/${n}`,sha256:sha(`${input}/${n}`),role:n}));manifest.rule_hash=sha(`${input}/rules.md`);fs.writeFileSync(`${input}/context-manifest.json`,JSON.stringify(manifest,null,2));const wpath=`${wd}/workflow.json`,w=JSON.parse(fs.readFileSync(wpath,'utf8'));w.task_ids.push(task);w.updated_at=now;fs.writeFileSync(wpath,JSON.stringify(w,null,2));console.log(JSON.stringify({task,run,art,input,tpath},null,2));
