const fs=require('fs'),crypto=require('crypto');const repo='D:/MicroConnect/project/openclaw-multi-agent',rt=repo+'/runtime',wf='WF-ef1c5f87-93c5-4ec7-a074-3dea54831ca1',task='TASK-88df9a42-f643-4607-b296-5bae3337c8d8',run='RUN-4a01107f-aa24-465e-aebe-0bc01b34181d',wd=`${rt}/control/workflows/${wf}`,art=`${rt}/artifacts/${wf}/${task}/${run}`;const now=new Date().toISOString();const wfPath=`${wd}/workflow.json`,w=JSON.parse(fs.readFileSync(wfPath,'utf8'));Object.assign(w,{status:'ANALYZING_REQUIREMENTS',status_reason:'需求产物已通过校验，准备完成需求任务',current_phase:'REQUIREMENTS',state_revision:2,updated_at:now});w.context_summary_sha256=crypto.createHash('sha256').update(fs.readFileSync(`${wd}/context-summary.md`)).digest('hex');fs.writeFileSync(wfPath,JSON.stringify(w,null,2),'utf8');const tp=`${wd}/tasks/${task}.json`,t=JSON.parse(fs.readFileSync(tp,'utf8'));Object.assign(t,{status:'DISPATCHED',updated_at:now});fs.writeFileSync(tp,JSON.stringify(t,null,2),'utf8');const ap=`${rt}/control/active-workflows.json`,a=JSON.parse(fs.readFileSync(ap,'utf8'));const x=a.workflows.find(x=>x.workflow_id===wf);Object.assign(x,{status:w.status,current_phase:w.current_phase,current_candidate_commit:w.current_candidate_commit,state_revision:2,updated_at:now});fs.writeFileSync(ap,JSON.stringify(a,null,2),'utf8');fs.writeFileSync(`${art}/output/manager-summary.md`,'需求 Agent 产物已完成独立契约校验：result.json、evidence.jsonl、command-records.jsonl 均通过；需求报告确认 A 方案与 18 项验收标准。\n','utf8');
function draft(name,fromS,toS,fromP,toP,before,after){return {event_id:name,timestamp:new Date().toISOString(),workflow_id:wf,task_id:task,run_id:run,actor:'manager-agent',event_type:after==='RUNNING'?'TASK_STARTED':'REQUIREMENTS_COMPLETED',from_status:fromS,to_status:toS,from_phase:fromP,to_phase:toP,task_status_before:before,task_status_after:after,candidate_commit:w.current_candidate_commit,payload:{gate_id:'GATE-REQ-001',gate_overall:'PASS'}}}fs.writeFileSync(`${wd}/event-draft-running.json`,JSON.stringify(draft('EVT-REQ-RUNNING-001','ANALYZING_REQUIREMENTS','ANALYZING_REQUIREMENTS','REQUIREMENTS','REQUIREMENTS','DISPATCHED','RUNNING'),null,2),'utf8');fs.writeFileSync(`${wd}/event-draft-completed.json`,JSON.stringify(draft('EVT-REQ-COMPLETE-001','ANALYZING_REQUIREMENTS','DESIGNING','REQUIREMENTS','ARCHITECTURE','RUNNING','COMPLETED'),null,2),'utf8');
