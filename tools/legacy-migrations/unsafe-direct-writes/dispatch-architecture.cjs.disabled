const fs=require('fs');const p='runtime/control/workflows/WF-ef1c5f87-93c5-4ec7-a074-3dea54831ca1';const task='TASK-114b5a6f-a436-4b87-ae5c-59dca89ab170';const t=JSON.parse(fs.readFileSync(`${p}/tasks/${task}.json`,'utf8'));const now=new Date().toISOString();const d={event_id:'EVT-ARCH-DISPATCH-001',timestamp:now,workflow_id:t.workflow_id,task_id:t.task_id,run_id:t.run_id,actor:'manager-agent',event_type:'TASK_DISPATCHED',from_status:'DESIGNING',to_status:'DESIGNING',from_phase:'ARCHITECTURE',to_phase:'ARCHITECTURE',task_status_before:'READY',task_status_after:'DISPATCHED',candidate_commit:t.input_commit,payload:{attempt:t.attempt,assigned_agent:t.assigned_agent,context_manifest_path_abs:t.context_manifest_path_abs}};fs.writeFileSync(`${p}/event-draft-architecture.json`,JSON.stringify(d,null,2),'utf8');t.status='DISPATCHED';t.updated_at=now;fs.writeFileSync(`${p}/tasks/${task}.json`,JSON.stringify(t,null,2),'utf8');const w=JSON.parse(fs.readFileSync(`${p}/workflow.json`,'utf8'));w.updated_at=now;fs.writeFileSync(`${p}/workflow.json`,JSON.stringify(w,null,2),'utf8');const ap='runtime/control/active-workflows.json',a=JSON.parse(fs.readFileSync(ap,'utf8'));const x=a.workflows.find(x=>x.workflow_id===w.workflow_id);x.updated_at=now;fs.writeFileSync(ap,JSON.stringify(a,null,2),'utf8');
