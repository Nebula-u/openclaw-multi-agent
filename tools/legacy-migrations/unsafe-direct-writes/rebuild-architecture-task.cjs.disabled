const fs=require('fs');
const crypto=require('crypto');
const root='runtime/control/workflows/WF-ef1c5f87-93c5-4ec7-a074-3dea54831ca1';
const w=JSON.parse(fs.readFileSync(root+'/workflow.json','utf8'));
const bad=w.task_ids.at(-1);
const badPath=root+'/tasks/'+bad+'.json';
const badTask=JSON.parse(fs.readFileSync(badPath,'utf8'));
badTask.status='SUPERSEDED';
badTask.status_reason='事件链创建错误，保留历史并由新架构任务替代';
badTask.updated_at=new Date().toISOString();
fs.writeFileSync(badPath,JSON.stringify(badTask,null,2));
const task='TASK-'+crypto.randomUUID();
const run='RUN-'+crypto.randomUUID();
const now=new Date().toISOString();
const art=`runtime/artifacts/${w.workflow_id}/${task}/${run}`;
const input=art+'/input';
const output=art+'/output';
const wt=`runtime/worktrees/${w.workflow_id}/${task}/${run}/repo`;
fs.mkdirSync(input,{recursive:true});fs.mkdirSync(output,{recursive:true});
const old='runtime/artifacts/'+w.workflow_id+'/TASK-88df9a42-f643-4607-b296-5bae3337c8d8/RUN-4a01107f-aa24-465e-aebe-0bc01b34181d/input';
for(const f of ['context.md','rules.md','acceptance-criteria.json','approved-decisions.json'])fs.copyFileSync(old+'/'+f,input+'/'+f);
fs.copyFileSync(root+'/context-summary.md',input+'/source-manifest.json');
const taskObj={schema_version:1,workflow_id:w.workflow_id,task_id:task,run_id:run,parent_task_id:'TASK-88df9a42-f643-4607-b296-5bae3337c8d8',task_type:'ARCHITECTURE',assigned_agent:'architect-agent',title:'Design TaskFlow architecture',description:'基于批准需求设计架构、测试策略、组件映射和关键取舍。',status:'CREATED',dependencies:['TASK-88df9a42-f643-4607-b296-5bae3337c8d8'],acceptance_criteria_ids:[],attempt:1,max_attempts:3,input_commit:w.current_candidate_commit,expected_branch:null,worktree_path_abs:wt,artifact_root_abs:art,context_manifest_path_abs:input+'/context-manifest.json',allowed_write_paths_abs:[output],forbidden_paths_abs:[w.target_project_root_abs+'/.git'],required_outputs:[output+'/result.json',output+'/architecture-report.md',output+'/test-strategy.md',output+'/user-summary.md',output+'/evidence.jsonl',output+'/command-records.jsonl',output+'/checksums.sha256'],approval_dependencies:[],created_at:now,updated_at:now};
fs.writeFileSync(root+'/tasks/'+task+'.json',JSON.stringify(taskObj,null,2));fs.copyFileSync(root+'/tasks/'+task+'.json',input+'/task.json');
const sha=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');
const names=['task.json','context.md','rules.md','acceptance-criteria.json','approved-decisions.json','source-manifest.json'];
const manifest={schema_version:1,workflow_id:w.workflow_id,task_id:task,run_id:run,assigned_agent:'architect-agent',created_at:now,manager_session_reference:'agent:manager-agent:main',target_project_root_abs:w.target_project_root_abs,worktree_path_abs:wt,artifact_root_abs:art,input_files:names.map(n=>({path_abs:input+'/'+n,sha256:sha(input+'/'+n),role:n})),rule_version:w.rules_version,rule_hash:sha(input+'/rules.md'),input_commit:w.current_candidate_commit,expected_output_paths_abs:taskObj.required_outputs};
fs.writeFileSync(input+'/context-manifest.json',JSON.stringify(manifest,null,2));
const triggers=['REQUIREMENT_AMBIGUITY','IMPLEMENTATION_TRADEOFF','PUBLIC_API_BREAKING_CHANGE','IRREVERSIBLE_DATA_OP','NEEDS_INSTALL_OR_NETWORK','NEEDS_CREDENTIALS','INPUT_NOT_GIT_REPO','INPUT_DIRTY_WORKTREE','CHANGE_APPROVED_REQ_OR_ARCH','THIRDPARTY_LICENSE_UNCLEAR','SECURITY_RISK_ACCEPTANCE','TEST_OR_SECURITY_EXCEPTION','RELEASE_HOLD_OVERRIDE','MAX_REWORK_EXCEEDED','DESTRUCTIVE_OR_CROSS_PROJECT'];
const assess={schema_version:1,workflow_id:w.workflow_id,scope:'TASK',task_id:task,run_id:run,assessed_at:now,evaluations:triggers.map(trigger=>({trigger,status:'NOT_TRIGGERED',rationale:'架构任务在批准范围内，不触发额外审批。',decision_id:null}))};fs.writeFileSync(root+'/approval-assessments/task-'+task+'.json',JSON.stringify(assess,null,2));
w.task_ids.push(task);w.updated_at=now;fs.writeFileSync(root+'/workflow.json',JSON.stringify(w,null,2));
const active='runtime/control/active-workflows.json';const a=JSON.parse(fs.readFileSync(active,'utf8'));const x=a.workflows.find(x=>x.workflow_id===w.workflow_id);Object.assign(x,{status:w.status,current_phase:w.current_phase,current_candidate_commit:w.current_candidate_commit,state_revision:w.state_revision,updated_at:now});fs.writeFileSync(active,JSON.stringify(a,null,2));
function draft(id,before,after,event_type){return {event_id:id,timestamp:new Date().toISOString(),workflow_id:w.workflow_id,task_id:task,run_id:run,actor:'manager-agent',event_type,from_status:'DESIGNING',to_status:'DESIGNING',from_phase:'ARCHITECTURE',to_phase:'ARCHITECTURE',task_status_before:before,task_status_after:after,candidate_commit:w.current_candidate_commit,payload:{assigned_agent:'architect-agent',context_manifest_path_abs:input+'/context-manifest.json'}};}
fs.writeFileSync(root+'/event-draft-arch2-created.json',JSON.stringify(draft('EVT-ARCH2-CREATED-001',null,'CREATED','ARCHITECTURE_TASK_CREATED')));
fs.writeFileSync(root+'/event-draft-arch2-ready.json',JSON.stringify(draft('EVT-ARCH2-READY-001','CREATED','READY','ARCHITECTURE_TASK_READY')));
fs.writeFileSync(root+'/event-draft-arch2-dispatched.json',JSON.stringify(draft('EVT-ARCH2-DISPATCHED-001','READY','DISPATCHED','TASK_DISPATCHED')));
console.log(JSON.stringify({task,run,art,input,wt},null,2));
