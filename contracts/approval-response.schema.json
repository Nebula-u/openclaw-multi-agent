{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/approval-response.schema.json",
  "title": "ApprovalResponse",
  "type": "object",
  "additionalProperties": true,
  "required": ["decision_id", "workflow_id", "outcome", "raw_user_reply_summary", "decided_by", "decided_at"],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^DEC-" },
    "workflow_id": { "type": "string", "pattern": "^WF-" },
    "outcome": { "type": "string", "enum": ["APPROVED", "REJECTED", "MODIFIED"] },
    "chosen_option_id": { "type": ["string", "null"] },
    "raw_user_reply_summary": { "type": "string", "minLength": 1 },
    "decided_by": { "type": "string", "description": "人工决策者标识（非自动）" },
    "decided_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
