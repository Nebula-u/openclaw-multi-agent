{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/contracts/supervision-request.schema.json",
  "title": "Supervision Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "idempotency_key", "workflow_id", "request_type", "source", "reason", "evidence", "requested_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^SUP-[A-Za-z0-9-]+$" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 500 },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9-]+$" },
    "task_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "dispatch_id": { "type": ["string", "null"] },
    "target_agent_id": { "type": ["string", "null"] },
    "request_type": { "enum": ["NUDGE", "SEND_MESSAGE", "RECONCILE", "RETRY_REVIEW", "PAUSE_REQUEST", "RESUME_REQUEST", "CANCEL_REQUEST", "ESCALATE"] },
    "source": { "enum": ["WATCHDOG", "LOCAL_USER", "MANAGER"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidence": { "type": "object" },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
