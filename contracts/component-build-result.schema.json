{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/contracts/component-build-result.schema.json",
  "title": "Generated Component Build Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "component_type",
    "component_id",
    "status",
    "package_path_abs",
    "validation",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string" },
    "component_type": { "enum": ["agent", "skill"] },
    "component_id": { "type": "string" },
    "status": { "enum": ["BUILT", "VALIDATED", "REGISTERED_INACTIVE", "ACTIVE", "DELETED", "FAILED"] },
    "package_path_abs": { "type": "string" },
    "validation": {
      "type": "object",
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": { "type": "array", "items": { "type": "object" } }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
