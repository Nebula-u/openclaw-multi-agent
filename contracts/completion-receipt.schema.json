{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microconnect.local/contracts/completion-receipt.schema.json",
  "title": "Dispatch Completion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "completion_id", "dispatch_id",
    "idempotency_key", "workflow_id", "task_id", "run_id", "agent_id",
    "attempt", "status", "session_key", "session_id", "result_path_abs",
    "result_sha256", "error_code", "error_message", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "COMPLETION_RECEIPT" },
    "completion_id": { "type": "string", "pattern": "^CMP-[A-Za-z0-9-]+$" },
    "dispatch_id": { "type": "string", "pattern": "^DSP-[A-Za-z0-9-]+$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9-]+$" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9-]+$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$" },
    "agent_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["SUCCEEDED", "FAILED", "LOST"] },
    "session_key": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "result_path_abs": { "type": ["string", "null"], "minLength": 1 },
    "result_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "error_code": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUCCEEDED" } } },
      "then": {
        "properties": {
          "result_path_abs": { "type": "string", "minLength": 1 },
          "result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "error_code": { "type": "null" },
          "error_message": { "type": "null" }
        }
      }
    }
  ]
}
