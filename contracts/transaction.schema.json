{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microconnect.local/contracts/transaction.schema.json",
  "title": "Workflow Transaction Journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "workflow_id",
    "owner_nonce",
    "expected_revision",
    "target_revision",
    "status",
    "created_at",
    "updated_at",
    "committed_at",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "transaction_id": { "type": "string", "pattern": "^TXN-[A-Za-z0-9-]+$" },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9-]+$" },
    "owner_nonce": { "type": "string", "format": "uuid" },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "target_revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["PREPARED", "APPLYING", "COMMITTED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "committed_at": { "type": ["string", "null"], "format": "date-time" },
    "operations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target_path_abs", "staged_path_abs", "content_sha256", "applied", "applied_at"],
        "properties": {
          "kind": {
            "enum": ["event-chain", "task-run-history", "task-current", "workflow", "active-index"]
          },
          "target_path_abs": { "type": "string", "minLength": 1 },
          "staged_path_abs": { "type": "string", "minLength": 1 },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "applied": { "type": "boolean" },
          "applied_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
