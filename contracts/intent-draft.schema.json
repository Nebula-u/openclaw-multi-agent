{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw.local/contracts/intent-draft.schema.json",
  "title": "MonitorIntentDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "intent_type", "summary", "confidence", "requires_confirmation"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "intent_id": { "type": "string", "pattern": "^INT-[A-Za-z0-9-]+$" },
    "intent_type": { "type": "string", "enum": ["QUESTION", "CREATE", "CHANGE", "DECISION"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "workflow_id": { "type": ["string", "null"] },
    "decision_id": { "type": ["string", "null"] },
    "choice": { "type": ["string", "null"] },
    "route_plan": { "type": ["object", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_confirmation": { "const": true }
  }
}
