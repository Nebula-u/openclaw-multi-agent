{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "workflow_id", "task_id", "run_id", "task_type",
    "assigned_agent", "title", "status", "attempt", "max_attempts",
    "worktree_path_abs", "artifact_root_abs", "context_manifest_path_abs", "structured_outputs",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "parent_task_id": { "type": ["string", "null"], "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "task_type": {
      "type": "string",
      "enum": [
        "REQUIREMENTS", "ARCHITECTURE", "DEVELOPMENT", "CODE_REVIEW",
        "DEVELOPER_REWORK", "TEST_IMPLEMENTATION", "TEST_CODE_REVIEW",
        "FAILURE_TRIAGE", "RELEASE_VERIFICATION"
      ]
    },
    "assigned_agent": {
      "type": "string",
      "enum": [
        "requirement-agent", "architect-agent", "developer-agent",
        "review-agent", "test-agent", "release-agent"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "CREATED", "READY", "DISPATCHED", "RUNNING", "WAITING_HUMAN",
        "BLOCKED", "NEEDS_REWORK", "COMPLETED", "FAILED", "CANCELLED",
        "SUPERSEDED", "LOST"
      ]
    },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$" } },
    "acceptance_criteria_ids": { "type": "array", "items": { "type": "string" } },
    "attempt": { "type": "integer", "minimum": 1 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "input_commit": { "type": ["string", "null"] },
    "expected_branch": { "type": ["string", "null"] },
    "worktree_path_abs": { "type": "string", "minLength": 1 },
    "artifact_root_abs": { "type": "string", "minLength": 1 },
    "context_manifest_path_abs": { "type": "string", "minLength": 1 },
    "allowed_write_paths_abs": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths_abs": { "type": "array", "items": { "type": "string" } },
    "required_outputs": { "type": "array", "items": { "type": "string" } },
    "structured_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_abs", "schema_path_abs", "format", "required", "producer"],
        "properties": {
          "path_abs": { "type": "string", "minLength": 1 },
          "schema_path_abs": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["json", "jsonl"] },
          "required": { "type": "boolean" },
          "producer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approval_dependencies": { "type": "array", "items": { "type": "string", "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9-]*$" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
