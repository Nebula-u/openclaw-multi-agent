{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/task.schema.json",
  "title": "Task",
  "description": "Manager 创建的权威任务控制记录，定义责任 Agent、状态和必须校验的跨 Agent 结构化产物。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "workflow_id", "task_id", "run_id", "task_type",
    "assigned_agent", "title", "status", "attempt", "max_attempts",
    "worktree_path_abs", "artifact_root_abs", "context_manifest_path_abs", "structured_outputs",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "description": "任务控制契约版本。" },
    "output_contract_version": { "type": "integer", "minimum": 1, "description": "本任务声明的 structured_outputs 契约版本。" },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9][A-Za-z0-9-]*$", "description": "任务所属 workflow 的不可变标识。" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$", "description": "任务唯一标识。" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9-]*$", "description": "本任务当前执行实例的唯一标识。" },
    "parent_task_id": { "type": ["string", "null"], "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "task_type": {
      "type": "string",
      "enum": [
        "REQUIREMENTS", "ARCHITECTURE", "DEVELOPMENT", "CODE_REVIEW",
        "DEVELOPER_REWORK", "TEST_IMPLEMENTATION", "TEST_CODE_REVIEW",
        "FAILURE_TRIAGE", "RELEASE_VERIFICATION"
      ],
      "description": "任务种类；只能取列出的流程阶段枚举。"
    },
    "assigned_agent": {
      "type": "string",
      "enum": [
        "requirement-agent", "architect-agent", "developer-agent",
        "review-agent", "test-agent", "release-agent"
      ],
      "description": "唯一负责产出此 task artifact 的 Agent；不得使用未注册角色。"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "CREATED", "READY", "DISPATCHED", "RUNNING", "WAITING_HUMAN",
        "BLOCKED", "NEEDS_REWORK", "COMPLETED", "FAILED", "CANCELLED",
        "SUPERSEDED", "LOST"
      ],
      "description": "任务状态机当前状态；只能使用列出的枚举值。"
    },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$" } },
    "acceptance_criteria_ids": { "type": "array", "items": { "type": "string" } },
    "attempt": { "type": "integer", "minimum": 1, "description": "当前 task/run 的尝试序号。" },
    "max_attempts": { "type": "integer", "minimum": 1, "description": "允许的最大尝试次数；超过后必须 fail-closed。" },
    "input_commit": { "type": ["string", "null"] },
    "expected_branch": { "type": ["string", "null"] },
    "worktree_path_abs": { "type": "string", "minLength": 1 },
    "artifact_root_abs": { "type": "string", "minLength": 1 },
    "context_manifest_path_abs": { "type": "string", "minLength": 1 },
    "allowed_write_paths_abs": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths_abs": { "type": "array", "items": { "type": "string" } },
    "required_outputs": { "type": "array", "items": { "type": "string" } },
    "structured_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_abs", "schema_path_abs", "format", "required", "producer"],
        "properties": {
          "path_abs": { "type": "string", "minLength": 1, "description": "artifact_root_abs 内待验证 JSON/JSONL 的绝对路径。" },
          "schema_path_abs": { "type": "string", "minLength": 1, "description": "contracts/ 内用于该产物的受信任 Schema 绝对路径。" },
          "format": { "type": "string", "enum": ["json", "jsonl"], "description": "序列化格式；json 为单一值，jsonl 为逐行 JSON 对象。" },
          "required": { "type": "boolean", "description": "任务完成时该产物是否必须存在且通过 Ajv。" },
          "producer": { "type": "string", "minLength": 1, "description": "负责写入该产物的 Agent，必须等于 assigned_agent。" }
        }
      }
    },
    "approval_dependencies": { "type": "array", "items": { "type": "string", "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9-]*$" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
