{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/workflow-control-command.schema.json",
  "title": "WorkflowControlCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "workflow_id", "run_id", "action", "actor", "notes", "submitted_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "command_id": { "type": "string", "pattern": "^WFC-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "action": { "type": "string", "enum": ["PAUSE", "RESUME"] },
    "actor": { "type": "string", "pattern": "^human:[A-Za-z0-9._-]+$" },
    "notes": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" }
  }
}
