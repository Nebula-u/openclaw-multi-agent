{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/approval-command.schema.json",
  "title": "ApprovalCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "workflow_id", "run_id", "task_id", "decision_id", "choice", "actor", "notes", "submitted_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "command_id": { "type": "string", "pattern": "^CMD-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "task_id": { "type": ["string", "null"], "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "decision_id": { "type": "string", "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "choice": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "pattern": "^human:[A-Za-z0-9._-]+$" },
    "notes": { "type": "string" },
    "submitted_at": { "type": "string", "format": "date-time" }
  }
}
