{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/transition-command.schema.json",
  "title": "Control Kernel Transition Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "workflow_id",
    "expected_revision",
    "command_type",
    "actor",
    "occurred_at",
    "reason",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "command_id": { "type": "string", "pattern": "^CMD-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "command_type": {
      "type": "string",
      "enum": [
        "BOOTSTRAP",
        "ADVANCE_PHASE",
        "WAIT_HUMAN",
        "HOLD",
        "RESUME",
        "SET_CANDIDATE",
        "COMPLETE",
        "FAIL",
        "CANCEL",
        "QUARANTINE"
      ]
    },
    "actor": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1 },
    "target_phase": {
      "type": ["string", "null"],
      "enum": [
        null,
        "INTAKE",
        "REQUIREMENTS",
        "REQUIREMENT_GATE",
        "ARCHITECTURE",
        "ARCHITECTURE_GATE",
        "DEVELOPMENT",
        "CODE_REVIEW",
        "DEVELOPER_REWORK",
        "TESTING",
        "TEST_CODE_REVIEW",
        "FAILURE_TRIAGE",
        "RELEASE_VERIFICATION",
        "FINAL_REPORT"
      ]
    },
    "outcome": {
      "type": ["string", "null"],
      "enum": [
        null,
        "READY_FOR_OPERATIONS_HANDOFF",
        "RELEASE_NO_GO",
        "FAILED",
        "CANCELLED",
        "QUARANTINED"
      ]
    },
    "candidate_commit": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}

