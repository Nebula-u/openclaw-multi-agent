{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/contracts/supervision-claim.schema.json",
  "title": "Supervision Claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "request_id", "claimed_by", "claimed_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "pattern": "^SUP-[A-Za-z0-9-]+$" },
    "claimed_by": { "type": "string", "minLength": 1 },
    "claimed_at": { "type": "string", "format": "date-time" }
  }
}
