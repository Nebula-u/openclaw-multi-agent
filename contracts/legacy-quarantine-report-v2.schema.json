{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/legacy-quarantine-report-v2.schema.json",
  "title": "Legacy v1 Forensic Quarantine Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "migration_id", "workflow_id", "source_control_root_abs",
    "archive_workflow_root_abs", "control_tree_sha256", "artifact_tree_sha256",
    "source_snapshot", "event_chain", "candidate_trust", "disposition", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "migration_id": { "type": "string", "pattern": "^MIG-[A-Za-z0-9-]+$" },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9-]+$" },
    "source_control_root_abs": { "type": "string", "minLength": 1 },
    "archive_workflow_root_abs": { "type": "string", "minLength": 1 },
    "control_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact_tree_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parseable", "claimed_revision", "status", "phase", "candidate_commit", "active_index_entry", "active_index_matches_snapshot"],
      "properties": {
        "parseable": { "type": "boolean" },
        "claimed_revision": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "type": ["string", "null"] },
        "phase": { "type": ["string", "null"] },
        "candidate_commit": { "type": ["string", "null"] },
        "active_index_entry": { "type": ["object", "null"] },
        "active_index_matches_snapshot": { "type": "boolean" }
      }
    },
    "event_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "trusted_prefix_revision", "fully_trusted", "snapshot_revision_matches", "errors"],
      "properties": {
        "records": { "type": "integer", "minimum": 0 },
        "trusted_prefix_revision": { "type": "integer", "minimum": 0 },
        "fully_trusted": { "type": "boolean" },
        "snapshot_revision_matches": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "object" } }
      }
    },
    "candidate_trust": { "const": "UNTRUSTED_OBSERVATION_ONLY" },
    "disposition": { "const": "QUARANTINE_TOMBSTONE_ONLY" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
