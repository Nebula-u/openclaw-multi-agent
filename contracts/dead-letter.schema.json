{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microconnect.local/contracts/dead-letter.schema.json",
  "title": "Dispatch Dead Letter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "dead_letter_id", "dispatch_id",
    "idempotency_key", "workflow_id", "task_id", "run_id", "agent_id",
    "attempt", "status", "retry_count", "max_retries", "last_error",
    "reason", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "DEAD_LETTER" },
    "dead_letter_id": { "type": "string", "pattern": "^DLQ-[A-Za-z0-9-]+$" },
    "dispatch_id": { "type": "string", "pattern": "^DSP-[A-Za-z0-9-]+$" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9-]+$" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9-]+$" },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$" },
    "agent_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "const": "DEAD_LETTER" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "max_retries": { "type": "integer", "minimum": 0 },
    "last_error": { "type": ["string", "null"] },
    "reason": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
