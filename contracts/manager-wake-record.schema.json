{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/contracts/manager-wake-record.schema.json",
  "title": "Manager Wake Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "wake_id", "status", "attempted_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "wake_id": { "type": "string", "pattern": "^WAKE-[A-Za-z0-9-]+$" },
    "status": { "enum": ["DELIVERED", "FAILED"] },
    "attempted_at": { "type": "string", "format": "date-time" },
    "manager_session_key": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"], "maxLength": 2000 },
    "next_attempt_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
