{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/context-manifest.schema.json",
  "title": "ContextManifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "workflow_id", "task_id", "run_id", "assigned_agent", "attempt",
    "created_at", "target_project_root_abs", "worktree_path_abs",
    "artifact_root_abs", "input_files", "rule_version", "rule_hash",
    "expected_output_paths_abs"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "workflow_id": { "type": "string", "pattern": "^WF-" },
    "task_id": { "type": "string", "pattern": "^TASK-" },
    "run_id": { "type": "string", "pattern": "^RUN-" },
    "assigned_agent": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "manager_session_reference": { "type": ["string", "null"] },
    "target_project_root_abs": { "type": "string", "minLength": 1 },
    "worktree_path_abs": { "type": "string", "minLength": 1 },
    "artifact_root_abs": { "type": "string", "minLength": 1 },
    "input_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_abs", "sha256"],
        "properties": {
          "path_abs": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "role": { "type": "string" }
        }
      }
    },
    "rule_version": { "type": "string" },
    "rule_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_commit": { "type": ["string", "null"] },
    "expected_output_paths_abs": { "type": "array", "items": { "type": "string" } }
  }
}
