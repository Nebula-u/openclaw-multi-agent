{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/review-findings.schema.json",
  "title": "ReviewFindings",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "workflow_id", "task_id", "reviewed_commit", "verdict", "findings"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "workflow_id": { "type": "string", "pattern": "^WF-" },
    "task_id": { "type": "string", "pattern": "^TASK-" },
    "reviewed_commit": { "type": "string", "minLength": 1 },
    "review_scope": { "type": "string", "enum": ["PRODUCTION_CODE", "TEST_CODE", "BOTH"] },
    "verdict": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCKED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "title", "description", "blocking", "status"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^FIND-" },
          "severity": { "type": "string", "enum": ["BLOCKER", "CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "commit": { "type": ["string", "null"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "remediation": { "type": "string" },
          "blocking": { "type": "boolean" },
          "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "WONT_FIX", "UNKNOWN", "NOT_EXECUTED"] }
        }
      }
    }
  }
}
