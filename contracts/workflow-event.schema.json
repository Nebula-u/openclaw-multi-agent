{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/workflow-event.schema.json",
  "title": "WorkflowEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "seq", "state_revision", "event_id", "timestamp",
    "workflow_id", "task_id", "run_id", "actor", "event_type",
    "from_status", "to_status", "from_phase", "to_phase",
    "task_status_before", "task_status_after", "candidate_commit",
    "previous_event_hash", "payload", "event_hash"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "state_revision": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^EVT-" },
    "timestamp": { "type": "string", "format": "date-time" },
    "workflow_id": { "type": "string", "pattern": "^WF-" },
    "task_id": { "type": ["string", "null"], "pattern": "^TASK-" },
    "run_id": { "type": ["string", "null"], "pattern": "^RUN-" },
    "actor": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "from_status": { "type": ["string", "null"] },
    "to_status": { "type": "string", "minLength": 1 },
    "from_phase": { "type": ["string", "null"] },
    "to_phase": { "type": "string", "minLength": 1 },
    "task_status_before": { "type": ["string", "null"] },
    "task_status_after": { "type": ["string", "null"] },
    "candidate_commit": { "type": ["string", "null"] },
    "previous_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": { "type": "object" },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
