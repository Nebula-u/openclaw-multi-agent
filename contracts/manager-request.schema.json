{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/manager-request.schema.json",
  "title": "ManagerOrchestratorRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_type", "workflow_id", "submitted_by", "manager_session_id", "manager_session_key", "user_authorized"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "pattern": "^REQ-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "request_type": { "type": "string", "enum": ["CREATE", "CHANGE", "DECISION"] },
    "workflow_id": { "type": "string", "pattern": "^WF-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "submitted_by": { "type": "string", "const": "manager-agent" },
    "submitted_at": { "type": "string", "format": "date-time" },
    "manager_session_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "manager_session_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "manager_delivery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reply_channel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reply_to": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "source_session_key": { "type": "string" },
    "project_ref": { "type": ["string", "null"], "pattern": "^PRJ-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "project_path_abs": { "type": "string", "minLength": 1 },
    "original_request": { "type": "string", "minLength": 1 },
    "route_plan": { "type": "object" },
    "decision_id": { "type": "string", "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "choice": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "user_authorized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "actor", "message"],
      "properties": {
        "confirmed": { "const": true },
        "actor": { "type": "string", "pattern": "^human:[A-Za-z0-9._-]+$" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "request_type": { "const": "DECISION" } } }, "then": { "required": ["decision_id", "choice"], "properties": { "decision_id": {}, "choice": {} } } },
    { "if": { "properties": { "request_type": { "enum": ["CREATE", "CHANGE"] } } }, "then": { "required": ["route_plan"], "properties": { "route_plan": {} } } },
    { "if": { "properties": { "request_type": { "const": "CREATE" } } }, "then": { "required": ["original_request"], "anyOf": [{ "required": ["project_ref"], "properties": { "project_ref": { "type": "string" } } }, { "required": ["project_path_abs"], "properties": { "project_path_abs": {} } }], "properties": { "project_ref": {}, "project_path_abs": {}, "original_request": {} } } }
  ]
}
