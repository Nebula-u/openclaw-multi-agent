{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/acceptance-criteria.schema.json",
  "title": "AcceptanceCriteria",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "workflow_id", "criteria"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "workflow_id": { "type": "string", "pattern": "^WF-" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "verification_method", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
          "statement": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string" },
          "source": { "type": "string", "description": "来源：用户需求引用 / 文件 / 决策" },
          "verification_method": { "type": "string", "description": "如何验证（测试/演示/检查）" },
          "priority": { "type": "string", "enum": ["MUST", "SHOULD", "COULD", "WONT"] },
          "verifiable": { "type": "boolean" },
          "status": { "type": "string", "enum": ["PROPOSED", "APPROVED", "IMPLEMENTED", "VERIFIED", "FAILED", "UNKNOWN"] }
        }
      }
    }
  }
}
