{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openclaw-sdlc-multi-agent/contracts/control-event-v2.schema.json",
  "title": "Control Kernel Event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id", "seq", "revision", "command_id", "event_type", "actor", "occurred_at",
    "from_state", "to_state", "payload", "previous_event_hash", "event_hash"
  ],
  "properties": {
    "workflow_id": { "type": "string", "pattern": "^WF-" },
    "seq": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "command_id": { "type": "string", "pattern": "^CMD-" },
    "event_type": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "from_state": { "type": ["object", "null"] },
    "to_state": { "type": "object" },
    "payload": { "type": "object" },
    "previous_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
