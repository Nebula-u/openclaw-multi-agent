{
  "id": "stategraph-webchat",
  "name": "StateGraph Manager CLI Bridge",
  "description": "Leaves Manager CLI conversation untouched and processes only user-confirmed workflow request files.",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectRoot": { "type": "string" },
      "targetProjectRoot": { "type": "string" },
      "managerAgentId": { "type": "string" },
      "managerWorkspace": { "type": "string" },
      "sessionPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "scanIntervalMs": { "type": "integer", "minimum": 500 }
    }
  },
  "activation": { "onStartup": true }
}
