MONITOR_TOKEN=openclaw-local-monitor
MONITOR_PORT=4319
MONITOR_URL=http://127.0.0.1:4319

# Optional fallback for unqualified model ids. Qualified values such as
# provider/model derive their provider from the model reference.
# OPENCLAW_LLM_PROVIDER=openai
OPENCLAW_LLM_API=openai-completions
OPENCLAW_LLM_BASE_URL=https://api.openai.com/v1
OPENCLAW_LLM_CONTEXT_WINDOW_TOKENS=128000
OPENCLAW_LLM_MAX_OUTPUT_TOKENS=49152
OPENCLAW_LLM_MAX_SESSION_TOKENS=200000
OPENCLAW_LLM_MAX_TOKENS_FIELD=max_completion_tokens
OPENCLAW_LLM_THINKING_LEVEL=medium
OPENCLAW_MANAGER_SOFT_BUDGET_PERCENT=60

# Provider-specific transport overrides are generic and apply to any Agent
# that references the matching provider/model. API keys remain in OpenClaw.
OPENCLAW_PROVIDER_DEEPSEEK_API=openai-completions
OPENCLAW_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENCLAW_AGENT_MANAGER_AGENT_MODEL=deepseek/deepseek-v4-pro
OPENCLAW_AGENT_REQUIREMENT_AGENT_MODEL=deepseek/deepseek-v4-flash
OPENCLAW_AGENT_ARCHITECT_AGENT_MODEL=deepseek/deepseek-v4-pro
OPENCLAW_AGENT_DEVELOPER_AGENT_MODEL=deepseek/deepseek-v4-pro
OPENCLAW_AGENT_REVIEW_AGENT_MODEL=deepseek/deepseek-v4-pro
OPENCLAW_AGENT_TEST_AGENT_MODEL=deepseek/deepseek-v4-flash
OPENCLAW_AGENT_RELEASE_AGENT_MODEL=deepseek/deepseek-v4-flash
