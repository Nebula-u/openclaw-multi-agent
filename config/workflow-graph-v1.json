{
  "schema_version": 1,
  "state_machine_version": 2,
  "$comment": "StateGraph execution policy only. Legal workflow transitions remain authoritative in control-state-machine-v2.json and reducer.mjs.",
  "phases": {
    "INTAKE": {
      "kind": "intake",
      "standard_next": "REQUIREMENTS",
      "demo_fast_next": "DEVELOPMENT"
    },
    "REQUIREMENTS": {
      "kind": "task",
      "task_type": "REQUIREMENTS",
      "agent": "requirement-agent",
      "on_completed": "REQUIREMENT_GATE"
    },
    "REQUIREMENT_GATE": {
      "kind": "gate",
      "gate_name": "RequirementGate",
      "on_pass": "ARCHITECTURE",
      "on_fail": "REQUIREMENTS"
    },
    "ARCHITECTURE": {
      "kind": "task",
      "task_type": "ARCHITECTURE",
      "agent": "architect-agent",
      "on_completed": "ARCHITECTURE_GATE"
    },
    "ARCHITECTURE_GATE": {
      "kind": "gate",
      "gate_name": "ArchitectureGate",
      "on_pass": "DEVELOPMENT",
      "on_fail": "ARCHITECTURE"
    },
    "DEVELOPMENT": {
      "kind": "task",
      "task_type": "DEVELOPMENT",
      "agent": "developer-agent",
      "on_completed": "CODE_REVIEW"
    },
    "CODE_REVIEW": {
      "kind": "task",
      "task_type": "CODE_REVIEW",
      "agent": "review-agent",
      "on_completed": "TESTING",
      "on_needs_rework": "DEVELOPER_REWORK"
    },
    "DEVELOPER_REWORK": {
      "kind": "task",
      "task_type": "DEVELOPER_REWORK",
      "agent": "developer-agent",
      "on_completed": "CODE_REVIEW"
    },
    "TESTING": {
      "kind": "task",
      "task_type": "TEST_IMPLEMENTATION",
      "agent": "test-agent",
      "on_completed": "TEST_CODE_REVIEW",
      "on_failed": "FAILURE_TRIAGE"
    },
    "TEST_CODE_REVIEW": {
      "kind": "task",
      "task_type": "TEST_CODE_REVIEW",
      "agent": "review-agent",
      "on_completed": "RELEASE_VERIFICATION",
      "on_needs_rework": "FAILURE_TRIAGE"
    },
    "FAILURE_TRIAGE": {
      "kind": "triage",
      "task_type": "FAILURE_TRIAGE",
      "agent": "developer-agent"
    },
    "RELEASE_VERIFICATION": {
      "kind": "release",
      "task_type": "RELEASE_VERIFICATION",
      "agent": "release-agent",
      "on_go": "FINAL_REPORT",
      "on_no_go": "FINAL_REPORT",
      "on_failed": "FAILURE_TRIAGE"
    },
    "FINAL_REPORT": {
      "kind": "final"
    }
  }
}
