{
  "schema_version": 1,
  "policy_id": "test-agent-docker-sandbox",
  "enabled": true,
  "required": true,
  "fail_closed": true,
  "isolation_mode": "SANDBOXED_DOCKER",
  "agent_id": "test-agent",
  "mode": "all",
  "backend": "docker",
  "scope": "session",
  "workspace_access": "rw",
  "prune": {
    "idle_hours": 1
  },
  "exec_host": "sandbox",
  "elevated_enabled": false,
  "docker": {
    "image": "openclaw-test-node:22-slim",
    "workdir": "/workspace/.task-sandbox/repo",
    "network": "none",
    "read_only_root": true,
    "cap_drop": ["ALL"],
    "pids_limit": 256,
    "memory": "2g",
    "cpus": 2,
    "dangerously_allow_external_bind_sources": true,
    "dangerously_allow_reserved_container_targets": false
  },
  "mounts": {
    "worktree": { "container_path": "/workspace/.task-sandbox/repo", "mode": "rw" },
    "input": { "container_path": "/workspace/.task-sandbox/input", "mode": "ro" },
    "agent_raw": { "container_path": "/workspace/.task-sandbox/output", "mode": "rw" },
    "raw_logs": { "container_path": "/workspace/.task-sandbox/raw-logs", "mode": "rw" }
  }
}
