{
  "schema_version": 1,
  "model_context_window_tokens": 200000,
  "soft_budget_percent": 60,
  "soft_budget_tokens": 120000,
  "thinking_level": "medium",
  "on_soft_budget_reached": "start_new_manager_session",
  "compaction": {
    "allowed": true,
    "command": "openclaw sessions compact <session-key> --max-lines <N>",
    "mode": "truncate_only"
  },
  "prompt_content": {
    "include": ["context-summary.md", "rules-snapshot.md", "Control Kernel manager-context snapshot", "pending approval and gate locators"],
    "exclude": ["complete chat history", "complete Control Kernel snapshot", "historical task snapshots", "dispatch receipts and completion payloads", "complete historical Guard output", "complete raw command logs", "complete historical Agent summaries"]
  }
}
