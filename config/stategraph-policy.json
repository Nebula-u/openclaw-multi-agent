{
  "schema_version": 1,
  "framework": "langgraph-stategraph-checkpointer",
  "max_graph_turns_per_scan": 8,
  "recursion_limit": 64,
  "agent_attempts": 3,
  "json_regeneration_retries": 2,
  "agent_timeout_seconds": 900,
  "lease_seconds": 120,
  "heartbeat_interval_seconds": 30,
  "parallelism": { "enabled": false, "max_parallel": 1 },
  "manager": {
    "context_window_tokens": 200000,
    "max_output_tokens": 32000,
    "soft_budget_percent": 60,
    "prompt_max_chars": 12000,
    "recent_events": 8,
    "recent_error_reports": 4
  },
  "task_agents": {
    "MANAGER_ANALYSIS": "manager-agent",
    "REQUIREMENTS": "requirement-agent",
    "ARCHITECTURE": "architect-agent",
    "DESIGN": "architect-agent",
    "DEVELOPMENT": "developer-agent",
    "CODE_REVIEW": "review-agent",
    "TEST": "test-agent",
    "RELEASE": "release-agent"
  },
  "route_rules": {
    "architecture_risk_flags": [
      "architecture_change",
      "data_migration",
      "public_api",
      "security_boundary",
      "multi_component"
    ],
    "development_free_classes": ["TEST_ONLY", "ANALYSIS_ONLY", "RELEASE_ONLY"],
    "requirements_optional_classes": ["TEST_ONLY"],
    "test_required_after_development": true,
    "route_confirmation_required": true
  },
  "gate_checks": {
    "REQUIREMENTS": ["scope", "boundaries", "acceptance_criteria"],
    "ARCHITECTURE": ["constraints", "data_flow", "risks"],
    "DESIGN": ["interaction_states", "accessibility", "responsive_layout"],
    "DEVELOPMENT": ["implementation", "build", "static_checks"],
    "CODE_REVIEW": ["commit_binding", "findings", "regression_risk"],
    "TEST": ["test_execution", "regression", "failure_evidence"],
    "RELEASE": ["candidate_binding", "rollback", "release_readiness"]
  }
}
