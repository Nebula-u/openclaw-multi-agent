{
  "schema_version": 2,
  "$comment": "唯一用于新 workflow 的状态机。审批等待使用 condition=WAITING_HUMAN；approval request 的 status=PENDING 不是 workflow 状态。",
  "phases": [
    "INTAKE",
    "REQUIREMENTS",
    "REQUIREMENT_GATE",
    "ARCHITECTURE",
    "ARCHITECTURE_GATE",
    "DEVELOPMENT",
    "CODE_REVIEW",
    "DEVELOPER_REWORK",
    "TESTING",
    "TEST_CODE_REVIEW",
    "FAILURE_TRIAGE",
    "RELEASE_VERIFICATION",
    "FINAL_REPORT"
  ],
  "phase_transitions": {
    "INTAKE": {
      "STANDARD_FLOW": "REQUIREMENTS",
      "DEMO_FAST_APPROVED": "DEVELOPMENT"
    },
    "REQUIREMENTS": { "COMPLETED": "REQUIREMENT_GATE" },
    "REQUIREMENT_GATE": {
      "FAIL_REQUIREMENTS": "REQUIREMENTS",
      "PASS": "ARCHITECTURE"
    },
    "ARCHITECTURE": { "COMPLETED": "ARCHITECTURE_GATE" },
    "ARCHITECTURE_GATE": {
      "FAIL_REQUIREMENTS": "REQUIREMENTS",
      "FAIL_ARCHITECTURE": "ARCHITECTURE",
      "PASS": "DEVELOPMENT"
    },
    "DEVELOPMENT": { "COMPLETED": "CODE_REVIEW" },
    "CODE_REVIEW": {
      "NEEDS_REWORK": "DEVELOPER_REWORK",
      "COMPLETED": "TESTING"
    },
    "DEVELOPER_REWORK": { "COMPLETED": "CODE_REVIEW" },
    "TESTING": {
      "COMPLETED": "TEST_CODE_REVIEW",
      "FAILED": "FAILURE_TRIAGE"
    },
    "TEST_CODE_REVIEW": {
      "NEEDS_REWORK": "FAILURE_TRIAGE",
      "COMPLETED": "RELEASE_VERIFICATION"
    },
    "FAILURE_TRIAGE": {
      "TO_REQUIREMENTS": "REQUIREMENTS",
      "TO_ARCHITECTURE": "ARCHITECTURE",
      "TO_DEVELOPMENT": "DEVELOPMENT",
      "TO_DEVELOPER_REWORK": "DEVELOPER_REWORK",
      "TO_TESTING": "TESTING",
      "TO_TEST_CODE_REVIEW": "TEST_CODE_REVIEW",
      "TO_RELEASE_VERIFICATION": "RELEASE_VERIFICATION"
    },
    "RELEASE_VERIFICATION": {
      "FAILED": "FAILURE_TRIAGE",
      "RELEASE_GO": "FINAL_REPORT",
      "RELEASE_NO_GO": "FINAL_REPORT"
    },
    "FINAL_REPORT": {}
  },
  "conditions": ["ACTIVE", "WAITING_HUMAN", "HOLD", "TERMINAL"],
  "terminal_outcomes": [
    "READY_FOR_OPERATIONS_HANDOFF",
    "RELEASE_NO_GO",
    "FAILED",
    "CANCELLED",
    "QUARANTINED"
  ]
}

