      "DEVELOPER_REWORK",
      "TESTING",
      "TEST_CODE_REVIEW",
      "RELEASE_VERIFICATION"
    ],
    "RELEASE_VERIFICATION": ["FAILURE_TRIAGE", "FINAL_REPORT"],
    "FINAL_REPORT": []
  },
  "conditions": ["ACTIVE", "WAITING_HUMAN", "HOLD", "TERMINAL"],
