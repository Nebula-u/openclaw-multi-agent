# Copy this file to .env when setting up another checkout.
MONITOR_PORT=4319
# Optional: enables only the Monitor's localhost outbox-retry endpoint. It does
# not authorize workflow creation, progression, approval, cancellation, or rework.
# MONITOR_INTERNAL_RETRY_TOKEN=replace-with-a-local-random-token

# Project-wide model catalog limits. Per-Agent OPENCLAW_AGENT_<ID>_* values may
# override these, but all Agents sharing one provider/model must stay identical.
OPENCLAW_LLM_CONTEXT_WINDOW_TOKENS=200000
OPENCLAW_LLM_MAX_OUTPUT_TOKENS=32000
OPENCLAW_LLM_MAX_TOKENS_FIELD=max_output_tokens

# ─── Control Kernel (PostgreSQL) ────────────────────────────────────────────
# Required for Orchestrator workflow runs. If unset, Kernel-backed commands and
# tests cannot operate; there is no checkpoint or SQLite workflow fallback.
OPENCLAW_PG_URL=postgresql://openclaw:password@localhost:5432/openclaw
# OPENCLAW_PG_POOL_MAX=8
# OPENCLAW_PG_STATEMENT_TIMEOUT_MS=15000
# OPENCLAW_PG_CONNECT_TIMEOUT_MS=5000
# OPENCLAW_KERNEL_LEASE_SECONDS=120
# OPENCLAW_WORKER_ID=worker-1
# Kernel 表所在 schema。连接池按连接 SET search_path 到该 schema，因为
# repository/lease/kernel 的 SQL 全部使用裸表名。
# OPENCLAW_KERNEL_SCHEMA=kernel
