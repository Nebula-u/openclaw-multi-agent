# Copy this file to .env when setting up another checkout.
MONITOR_PORT=4319

# Project-wide model catalog limits. Per-Agent OPENCLAW_AGENT_<ID>_* values may
# override these, but all Agents sharing one provider/model must stay identical.
OPENCLAW_LLM_CONTEXT_WINDOW_TOKENS=200000
OPENCLAW_LLM_MAX_OUTPUT_TOKENS=32000
OPENCLAW_LLM_MAX_TOKENS_FIELD=max_output_tokens

# OpenClaw Agent model routing. Replace values with provider/model references.
# The thinking level is shared by all Agents through agents.defaults.thinkingDefault.
OPENCLAW_THINKING_LEVEL=high
# OPENCLAW_AGENT_MANAGER_AGENT_MODEL=provider/model-id
# OPENCLAW_AGENT_REQUIREMENT_AGENT_MODEL=provider/model-id
# OPENCLAW_AGENT_ARCHITECT_AGENT_MODEL=provider/model-id
# OPENCLAW_AGENT_DEVELOPER_AGENT_MODEL=provider/model-id
# OPENCLAW_AGENT_REVIEW_AGENT_MODEL=provider/model-id
# OPENCLAW_AGENT_TEST_AGENT_MODEL=provider/model-id
# OPENCLAW_AGENT_RELEASE_AGENT_MODEL=provider/model-id

# ─── Control Kernel (single-machine SQLite) ─────────────────────────────────
# Must be a local-disk path. Do not place this file on SMB/NFS/cloud-sync storage.
OPENCLAW_KERNEL_DB_PATH=runtime/control/kernel.db
# OPENCLAW_KERNEL_BUSY_TIMEOUT_MS=5000
# OPENCLAW_KERNEL_LEASE_SECONDS=120
# OPENCLAW_WORKER_ID=worker-1

# HR remains available for explicit review commands. Automatic scheduling is
# disabled by default; allowed values: off, task, daily, both.
OPENCLAW_HR_ENABLED=true
OPENCLAW_HR_AUTO_MODE=off
